#include <iostream>

using namespace std;

void print (int *num) { cout << *num; }

void change (int ptr, int size, int *max, int *min) {
    *max = ptr[0]; *min = ptr[0];
    int emplScoreMore = 0;

    for (int i = 1; i < size; i++) {
        if (*max < ptr[i]) { *max = ptr[i]; }
        if (*min > ptr[i]) { *min = ptr[i]; }

        float sum = 0.0; sum += ptr[i];
        float average = sum / 2.0;

        for (int j = 1; j < size; j++) {
            if (ptr[i] > average) {
                emplScoreMore ++;
            }
        }

        print (&max); cout << "Maximum score " << endl;
        print (&min); cout << "Minimum score " << endl;
        cout << "Average score: " << average;
        cout << "Empoyes those score is more than average" << emplScoreMore;
    }
}

int main() {
    int arr[10];

    for (int i = 0; i < 10; i++) {
        cin >> arr[i];
    }

    int Vmax, Vmin;

    change (arr[i], 10, &Vmax, &Vmin);

    return 0;
}
